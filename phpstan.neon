parameters:
    paths:
        - ./src
        - ./tests/feature
    level: 6

    ignoreErrors:
        -
            messages:
                - '#unction SConcur\\Extension\\(destroy|push|next|stopFlow|httpStopAccepting|socketStopAccepting|wsStopAccepting|amqpStopConsuming|amqpReopenConsumer|tasksCount|wait|waitAny|waitAnyBatch|waitAnyTimeout|waitAnyTimeoutBatch|version|armPreemption|disarmPreemption) not found#'
                - '#generic class Fiber [\s\S]* not specify its types: TStart, TResume, TReturn, TSuspend#'
        # Kept apart on purpose. PHPStan 2.1 rewrites the literal sequences \r and
        # \n in a message before matching (IgnoredError::shouldIgnore), so the
        # message reads "...Extension\nesetEngineState..." and an alternation with
        # this name never matches; a pattern that contains the same "\\r" is rewritten
        # the same way and does. Any function here whose name starts with "r" or "n"
        # needs its own entry like this one.
        - '#unction SConcur\\Extension\\resetEngineState not found#'
