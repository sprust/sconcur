{
  "phpBinary": "php",
  "phpArgs": [
    "-d",
    "extension=/sconcur/ext/build/sconcur.so"
  ],
  "panelPort": 8081,
  "adminToken": "23c30b4089383dd332585af6f02ff65de38179d52546b770942bd63e9894c3ec",
  "runtimeDir": "/sconcur/tests/storage/servers",
  "logDir": "/sconcur/tests/storage/logs",
  "name": "sconcur-servers",
  "rotateDays": 3,
  "logTo": "both",
  "restartPolicy": "always",
  "shutdownTimeoutMs": 10000,
  "restartBackoffMs": 200,
  "maxRestartBackoffMs": 30000,
  "groups": [
    {
      "name": "http",
      "workerScript": "/sconcur/tests/servers/http/http-server.php",
      "workerCount": 2,
      "workerArgs": [],
      "server": {
        "address": "0.0.0.0:8080",
        "reusePort": true,
        "maxRequests": 0,
        "maxConcurrency": 0,
        "maxRequestBody": 10485760,
        "readHeaderTimeoutMs": 10000,
        "readTimeoutMs": 30000,
        "writeTimeoutMs": 30000,
        "idleTimeoutMs": 60000,
        "handlerTimeoutMs": 15000,
        "shutdownTimeoutMs": 10000
      }
    },
    {
      "name": "socket",
      "workerScript": "/sconcur/tests/servers/socket/socket-server.php",
      "workerCount": 2,
      "workerArgs": [],
      "server": {
        "address": "0.0.0.0:9100",
        "reusePort": true,
        "maxConnections": 0,
        "maxConcurrency": 0,
        "maxMessageBytes": 1048576,
        "readTimeoutMs": 0,
        "writeTimeoutMs": 30000,
        "shutdownTimeoutMs": 10000
      }
    },
    {
      "name": "ws",
      "workerScript": "/sconcur/tests/servers/ws/ws-server.php",
      "workerCount": 2,
      "workerArgs": [],
      "server": {
        "address": "0.0.0.0:9200",
        "reusePort": true,
        "path": "/",
        "maxConnections": 0,
        "maxConcurrency": 0,
        "maxMessageBytes": 1048576,
        "handshakeTimeoutMs": 10000,
        "idleTimeoutMs": 0,
        "writeTimeoutMs": 30000,
        "pingIntervalMs": 30000,
        "shutdownTimeoutMs": 10000
      }
    },
    {
        "name": "rabbitmq",
        "workerScript": "/sconcur/tests/consumers/amqp/amqp-consumer.php",
        "workerCount": 2,
        "server": {
            "queues": [
                {
                    "name": "demo",
                    "coroutineCount": 4
                }
            ],
            "prefetchCount": 1,
            "handlerTimeoutMs": 5000
        }
    }
  ]
}
